from __future__ import annotations

import hashlib
import json
import re
import shutil
import subprocess
import time
from datetime import datetime
from pathlib import Path
from urllib.parse import urlsplit, urlunsplit, parse_qsl, urlencode

from .analyzer import (
    inspect_apk,
    analyze_manifest,
    scan_strings,
    decompile_with_jadx,
    extract_smali_with_apktool,
    write_report,
)


def _safe_package(value: str) -> str:
    parts = re.sub(r"[^a-zA-Z0-9.]", ".", value or "").lower().split(".")
    parts = [re.sub(r"^[^a-z]", "app", p) or "app" for p in parts]
    parts = [p for p in parts if p]
    if len(parts) < 2:
        parts = ["com", "reconstructed"]
    return ".".join(parts[:5])


def _redact_url(value: str) -> str:
    try:
        parts = urlsplit(value)
        sensitive = re.compile(
            r"(pass|senha|token|secret|api.?key|username|loginemail|credential)",
            re.I,
        )
        query = [
            (key, "[REDACTED]" if sensitive.search(key) else val)
            for key, val in parse_qsl(parts.query, keep_blank_values=True)
        ]
        return urlunsplit(
            (parts.scheme, parts.netloc, parts.path, urlencode(query), "")
        )
    except Exception:
        return "[URL OMITIDA]"


def _write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def _screen_names(manifest: dict) -> list[str]:
    result = []
    for component in manifest.get("components", []):
        if component.get("type") not in ("activity", "activity-alias"):
            continue
        name = str(component.get("name") or "").strip()
        if name and name not in result:
            result.append(name)
    return result[:120]


def _screen_label(name: str) -> str:
    value = name.rsplit(".", 1)[-1].replace("$", " ")
    value = re.sub(r"([a-z])([A-Z])", r"\1 \2", value)
    value = re.sub(r"[_-]+", " ", value)
    return value.strip() or "Tela"


def _generate_project(root: Path, package: str, screens: list[str],
                      apk_info: dict, manifest: dict) -> dict:
    app = root / "app"
    java_dir = app / "src/main/java" / Path(*package.split("."))
    res = app / "src/main/res"

    java_dir.mkdir(parents=True, exist_ok=True)
    (res / "layout").mkdir(parents=True, exist_ok=True)
    (res / "values").mkdir(parents=True, exist_ok=True)

    labels = [_screen_label(item) for item in screens]
    if not labels:
        labels = ["Início", "TV ao vivo", "Filmes", "Séries", "Configurações"]

    screen_json = [
        {"component": name, "label": _screen_label(name)}
        for name in screens
    ]

    _write(root / "settings.gradle", """pluginManagement {
    repositories {
        google()
        mavenCentral()
        gradlePluginPortal()
    }
}
dependencyResolutionManagement {
    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
    repositories {
        google()
        mavenCentral()
    }
}
rootProject.name = "ProjetoReconstruido"
include(":app")
""")

    _write(root / "build.gradle", """plugins {
    id 'com.android.application' version '8.7.3' apply false
}
""")

    _write(root / "gradle.properties", """org.gradle.jvmargs=-Xmx1536m -Dfile.encoding=UTF-8
android.useAndroidX=true
android.nonTransitiveRClass=true
""")

    _write(app / "build.gradle", f"""plugins {{
    id 'com.android.application'
}}

android {{
    namespace '{package}'
    compileSdk 35

    defaultConfig {{
        applicationId '{package}'
        minSdk 23
        targetSdk 28
        versionCode 1
        versionName '1.0'
    }}

    compileOptions {{
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }}
}}
""")

    _write(app / "src/main/AndroidManifest.xml", f"""<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:label="Projeto Reconstruído"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">
        <activity
            android:name=".{ 'ScreenActivity' }"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
""")

    _write(res / "values/strings.xml", """<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Projeto Reconstruído</string>
    <string name="home_title">Aplicativo reconstruído</string>
    <string name="screen_hint">Selecione uma seção para visualizar</string>
</resources>
""")

    _write(res / "values/styles.xml", """<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1565C0</item>
        <item name="android:statusBarColor">#101820</item>
        <item name="android:navigationBarColor">#101820</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
""")

    _write(res / "layout/activity_main.xml", """<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_hint"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:paddingBottom="18dp" />
        <LinearLayout
            android:id="@+id/screenList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
""")

    _write(res / "layout/activity_screen.xml", """<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101820"
    android:padding="20dp">
    <TextView
        android:id="@+id/screenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />
    <TextView
        android:id="@+id/screenDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#CFD8DC"
        android:textSize="16sp"
        android:text="Tela reconstruída a partir do inventário do APK." />
</LinearLayout>
""")

    java_main = f"""package {package};

import android.app.Activity;
import android.content.Intent;
import android.os.Bundle;
import android.view.ViewGroup;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.TextView;

public class MainActivity extends Activity {{
    private static final String[] SCREENS = new String[] {{
        {", ".join(json.dumps(x, ensure_ascii=False) for x in labels)}
    }};

    @Override
    protected void onCreate(Bundle state) {{
        super.onCreate(state);
        setContentView(R.layout.activity_main);
        LinearLayout list = findViewById(R.id.screenList);
        for (String name : SCREENS) {{
            Button button = new Button(this);
            button.setText(name);
            button.setAllCaps(false);
            button.setTextColor(0xFFFFFFFF);
            button.setBackgroundTintList(
                android.content.res.ColorStateList.valueOf(0xFF263746));
            LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT);
            params.bottomMargin = 10;
            list.addView(button, params);
            button.setOnClickListener(v -> {{
                Intent intent = new Intent(this, ScreenActivity.class);
                intent.putExtra("screen_title", name);
                startActivity(intent);
            }});
        }}
    }}
}}
"""
    _write(java_dir / "MainActivity.java", java_main)

    java_screen = f"""package {package};

import android.app.Activity;
import android.os.Bundle;
import android.widget.TextView;

public class ScreenActivity extends Activity {{
    @Override
    protected void onCreate(Bundle state) {{
        super.onCreate(state);
        setContentView(R.layout.activity_screen);
        String title = getIntent().getStringExtra("screen_title");
        if (title == null) title = "Tela";
        TextView heading = findViewById(R.id.screenTitle);
        heading.setText(title);
    }}
}}
"""
    _write(java_dir / "ScreenActivity.java", java_screen)

    _write(root / "screens.json", json.dumps(
        screen_json, ensure_ascii=False, indent=2
    ))
    _write(root / "README.md", f"""# Projeto Android reconstruído

Projeto nativo Java/XML gerado pelo ReaDroid.

## Estrutura
- `app/src/main/java`: código Java gerado.
- `app/src/main/res/layout`: layouts XML.
- `app/src/main/res/values`: strings e tema.
- `app/src/main/AndroidManifest.xml`: manifesto novo.
- `screens.json`: inventário de telas identificadas.
- `analysis/`: resultados da análise e extrações locais.

## Compilação
Abra a pasta no Android Studio com Android SDK instalado ou execute
`gradle assembleDebug` em um ambiente com SDK Android configurado.

## Limitações
Este projeto é uma reconstrução independente. As telas são estruturas
iniciais navegáveis, não uma recuperação do código-fonte original.
A lógica proprietária, serviços remotos, autenticação, reprodução,
imagens e regras internas precisam ser implementados e validados
separadamente. Nenhuma credencial ou conexão do APK original é reutilizada.

Pacote gerado: `{package}`
Componentes de tela identificados: {len(screens)}
SHA-256 do APK analisado: `{apk_info.get("sha256", "")}`
""")

    return {
        "package": package,
        "screens_identified": len(screens),
        "java_files_generated": 2,
        "xml_layouts_generated": 2,
        "project_root": str(root),
    }


def _existing_analysis(apk: Path):
    base = Path.home() / "gpt-assistente" / "analises"
    if not base.is_dir():
        return None
    candidates = []
    for folder in base.iterdir():
        if not folder.is_dir():
            continue
        if (folder / "codigo_java_jadx" / "sources").is_dir() and (folder / "res" / "values" / "public.xml").is_file():
            candidates.append(folder)
    if not candidates:
        return None
    matching = [p for p in candidates if apk.stem.lower().replace(" ", "_") in p.name.lower()]
    return sorted(matching or candidates, key=lambda p: p.stat().st_mtime, reverse=True)[0]


def _load_saved_report(pattern: str, apk_name: str):
    for path in sorted(Path("reports").glob(pattern), key=lambda p: p.stat().st_mtime, reverse=True):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            if data.get("apk") == apk_name or data.get("file_name") == apk_name:
                return data
        except Exception:
            continue
    return None


def reconstruct_apk(apk: Path, output_base: Path, progress=print) -> dict:
    start = time.time()
    apk = apk.expanduser().resolve()
    if not apk.is_file():
        raise FileNotFoundError(f"APK não encontrado: {apk}")

    output_base.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    root = output_base / f"{apk.stem}_projeto_android_{stamp}"
    root.mkdir(parents=True, exist_ok=False)

    report = {
        "tool": "ReaDroid Native Reconstruction",
        "apk": apk.name,
        "started_at": datetime.now().astimezone().isoformat(),
        "steps": {},
        "warnings": [],
    }

    analysis = _existing_analysis(apk)
    saved_info = _load_saved_report("*inspeção*.json", apk.name)
    saved_manifest = _load_saved_report("*manifesto*.json", apk.name)
    saved_strings = _load_saved_report("*scanner*.json", apk.name)

    if analysis and saved_info and saved_manifest:
        progress("1/4 - Reutilizando JADX, Apktool e relatórios já existentes...")
        info = saved_info
        manifest = saved_manifest
        strings = saved_strings or {"urls": [], "domains": []}
        strings["urls"] = [_redact_url(x) for x in strings.get("urls", [])]
        report["analysis_reused"] = str(analysis)
        report["steps"]["inspection"] = info
        report["steps"]["manifest"] = manifest
        report["steps"]["strings"] = strings
        report["warnings"].append(
            "A reconstrução usa uma análise anterior encontrada no armazenamento local."
        )
    else:
        progress("1/4 - Analisando APK: não foi encontrada análise anterior completa...")
        info = inspect_apk(apk)
        manifest = analyze_manifest(apk, root / "analysis/manifest_work")
        strings = scan_strings(apk)
        strings["urls"] = [_redact_url(x) for x in strings.get("urls", [])]
        report["steps"]["inspection"] = info
        report["steps"]["manifest"] = manifest
        report["steps"]["strings"] = strings
        progress("2/4 - Executando JADX...")
        jadx = decompile_with_jadx(apk, root / "analysis/jadx", threads=2)
        report["steps"]["jadx"] = jadx
        progress("3/4 - Executando Apktool...")
        apktool = extract_smali_with_apktool(apk, root / "analysis/apktool")
        report["steps"]["apktool"] = apktool
        analysis = root / "analysis/apktool"
        if not jadx.get("ok"):
            report["warnings"].append("JADX não concluiu integralmente.")
        if not apktool.get("ok"):
            report["warnings"].append("Apktool falhou ou não está disponível.")

    progress("4/4 - Gerando atividades Java e layouts XML nativos...")
    digest = info.get("sha256") or hashlib.sha256(apk.read_bytes()).hexdigest()
    package = "com.readroid.reconstructed.app" + digest[:6]
    from .native_project import generate_native_project
    generated = generate_native_project(root, package, manifest, analysis, info)
    report["generated_project"] = generated
    report["source_sha256"] = digest
    report["elapsed_seconds"] = round(time.time() - start, 2)
    report["limitations"] = [
        "Reconstrução independente baseada na estrutura das telas identificadas.",
        "Layouts complexos e componentes personalizados são aproximados com widgets Android padrão.",
        "Não recupera a lógica proprietária, autenticação, serviços remotos ou reprodução original.",
        "Não copia código-fonte, imagens ou identidade visual protegida do APK analisado.",
        "A compilação Gradle e o teste em dispositivo ainda precisam ser executados.",
    ]
    write_report(report, root / "reconstruction_report.json")
    return report
