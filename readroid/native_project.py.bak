        setting("Expiração", "Não aplicável");
        addButton(body, "TROCAR USUÁRIO", PANEL2, () -> navigate("users"));
    }

    private void searchScreen() {
        addSection(body, "BUSCA");
        EditText query = input("Digite o nome de um canal, filme ou série", false);
        body.addView(query);
        LinearLayout results = column();
        body.addView(results);
        Runnable update = () -> {
            results.removeAllViews();
            String q = query.getText().toString().toLowerCase();
            ArrayList<String> all = new ArrayList<>();
            all.addAll(Arrays.asList(channels));
            all.addAll(Arrays.asList(movies));
            all.addAll(Arrays.asList(series));
            for (String item : all) {
                if (q.isEmpty() || item.toLowerCase().contains(q)) {
                    TextView result = button(item, PANEL2, () -> {
                        selectedItem = item;
                        navigate("details");
                    });
                    LinearLayout.LayoutParams p = lp(-1, 48);
                    p.bottomMargin = dp(7);
                    results.addView(result, p);
                }
            }
        };
        query.addTextChangedListener(new TextWatcher() {
            public void beforeTextChanged(CharSequence s, int st, int c, int a) {}
            public void onTextChanged(CharSequence s, int st, int before, int count) {
                update.run();
            }
            public void afterTextChanged(Editable e) {}
        });
        update.run();
    }

