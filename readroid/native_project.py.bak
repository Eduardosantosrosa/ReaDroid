    private void catalog(String heading, String[] items, int accent) {
        TextView title = label(heading, 21, WHITE, true);
        body.addView(title, lp(-1, 42));
        TextView info = label("Categorias e conteúdos disponíveis", 12, MUTED, false);
        body.addView(info, lp(-1, 26));

        LinearLayout filters = row();
        String[] cats = {"Todos", "Recentes", "Favoritos"};
        for (String cat : cats) {
            TextView f = button(cat, PANEL2, () ->
                Toast.makeText(this, "Filtro: " + cat, Toast.LENGTH_SHORT).show());
            LinearLayout.LayoutParams fp = new LinearLayout.LayoutParams(0, dp(40), 1);
            fp.rightMargin = dp(5);
            filters.addView(f, fp);
        }
        body.addView(filters);
        gap(body, 14);

        for (int i = 0; i < items.length; i++) {
            final String item = items[i];
            LinearLayout card = row();
            card.setBackground(shape(PANEL, 9));
            pad(card, 12, 9, 12, 9);

            TextView icon = label(heading.equals("TV AO VIVO") ? "▶" : "▣",
                23, accent, true);
            icon.setGravity(Gravity.CENTER);
            card.addView(icon, lp(48, 52));

            LinearLayout details = column();
            TextView name = label(item, 14, WHITE, true);
            details.addView(name, lp(-1, 27));
            TextView desc = label(
                heading.equals("TV AO VIVO") ? "Canal demonstrativo" : "Detalhes e informações",
                11, MUTED, false);
            details.addView(desc, lp(-1, 22));
            card.addView(details, new LinearLayout.LayoutParams(0, -2, 1));

            TextView arrow = label("›", 24, MUTED, true);
            card.addView(arrow, lp(25, 45));

            card.setClickable(true);
            card.setOnClickListener(v -> {
                selectedItem = item;
                navigate("details");
            });
            LinearLayout.LayoutParams cp = lp(-1, 72);
            cp.bottomMargin = dp(8);
            body.addView(card, cp);
        }
    }

