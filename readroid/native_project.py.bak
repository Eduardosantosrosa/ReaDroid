    private void setting(String name, String value) {
        LinearLayout item = row();
        item.setBackground(shape(PANEL, 8));
        pad(item, 13, 9, 13, 9);
        LinearLayout texts = column();
        texts.addView(label(name, 14, WHITE, true), lp(-1, 25));
