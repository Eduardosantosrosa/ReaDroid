from __future__ import annotations

import json
import re
import xml.etree.ElementTree as ET
from pathlib import Path


def write(path: Path, content: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def safe_package(value: str) -> str:
    parts = []
    for part in str(value).split("."):
        part = re.sub(r"[^a-zA-Z0-9_]", "_", part)
        if not part or not part[0].isalpha():
            part = "app_" + part
        parts.append(part)
    return ".".join(parts[:5]) or "com.example.rebuilt"


def _activity_records(manifest: dict) -> list[dict]:
    records = []
    seen = set()
    for item in manifest.get("components", []):
        if item.get("type") != "activity":
            continue
        name = str(item.get("name") or "").strip()
        if not name or name in seen:
            continue
        seen.add(name)
        simple = name.rsplit(".", 1)[-1]
        records.append({
            "component": name,
            "simple_name": simple,
            "label": re.sub(r"([a-z])([A-Z])", r"\1 \2", simple),
        })
    return records


