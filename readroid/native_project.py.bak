    @Override
    public void onCreate(Bundle state) {
        super.onCreate(state);
        getWindow().setStatusBarColor(BG);
        getWindow().setNavigationBarColor(BG);
        getWindow().getDecorView().setSystemUiVisibility(0);
        show("login");
    }

    private int dp(float n) {
        return (int)(n * getResources().getDisplayMetrics().density + 0.5f);
    }

    private GradientDrawable shape(int color, int radius) {
        GradientDrawable d = new GradientDrawable();
        d.setColor(color);
        d.setCornerRadius(dp(radius));
        return d;
    }

    private LinearLayout column() {
        LinearLayout l = new LinearLayout(this);
        l.setOrientation(LinearLayout.VERTICAL);
        return l;
    }

    private LinearLayout row() {
        LinearLayout l = new LinearLayout(this);
        l.setOrientation(LinearLayout.HORIZONTAL);
        l.setGravity(Gravity.CENTER_VERTICAL);
        return l;
    }

    private TextView label(String value, int size, int color, boolean bold) {
        TextView t = new TextView(this);
        t.setText(value);
        t.setTextSize(size);
        t.setTextColor(color);
        t.setGravity(Gravity.CENTER_VERTICAL);
        if (bold) t.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        return t;
    }

    private void pad(View v, int a, int b, int c, int d) {
        v.setPadding(dp(a), dp(b), dp(c), dp(d));
    }

    private LinearLayout.LayoutParams lp(int w, int h) {
        return new LinearLayout.LayoutParams(
            w < 0 ? w : dp(w), h < 0 ? h : dp(h));
    }

    private void gap(LinearLayout parent, int height) {
        View v = new View(this);
        parent.addView(v, lp(1, height));
    }

    private TextView button(String value, int color, Runnable action) {
        TextView b = label(value, 14, WHITE, true);
        b.setGravity(Gravity.CENTER);
        b.setBackground(shape(color, 9));
        pad(b, 14, 12, 14, 12);
        b.setClickable(true);
        b.setFocusable(true);
        b.setOnClickListener(v -> action.run());
        return b;
    }

    private EditText input(String hint, boolean password) {
        EditText e = new EditText(this);
        e.setSingleLine(true);
        e.setTextColor(WHITE);
        e.setHintTextColor(MUTED);
        e.setHint(hint);
        e.setTextSize(15);
        e.setBackground(shape(PANEL2, 8));
        pad(e, 14, 5, 14, 5);
        if (password) {
            e.setInputType(129);
        }
        LinearLayout.LayoutParams p = lp(-1, 52);
        p.bottomMargin = dp(12);
        e.setLayoutParams(p);
        return e;
    }

    private void addButton(LinearLayout parent, String value, int color, Runnable action) {
        TextView b = button(value, color, action);
        LinearLayout.LayoutParams p = lp(-1, 48);
        p.bottomMargin = dp(9);
        parent.addView(b, p);
    }

    private void addCard(LinearLayout parent, String title, String subtitle,
                         int color, String symbol, Runnable action, int height) {
        LinearLayout card = column();
        card.setGravity(Gravity.CENTER);
        card.setBackground(shape(color, 12));
        pad(card, 12, 12, 12, 12);

        TextView icon = label(symbol, 30, WHITE, true);
        icon.setGravity(Gravity.CENTER);
        card.addView(icon, lp(-1, 45));

        TextView name = label(title, 17, WHITE, true);
        name.setGravity(Gravity.CENTER);
        card.addView(name, lp(-1, 30));

        if (subtitle != null && !subtitle.isEmpty()) {
            TextView sub = label(subtitle, 11, WHITE, false);
            sub.setGravity(Gravity.CENTER);
            card.addView(sub, lp(-1, 24));
        }

        card.setClickable(true);
        card.setFocusable(true);
        card.setOnClickListener(v -> action.run());
        parent.addView(card, lp(-1, height));
    }

    private void addSection(LinearLayout parent, String title) {
        TextView t = label(title, 18, WHITE, true);
        pad(t, 2, 12, 2, 10);
        parent.addView(t, lp(-1, -2));
    }

    private void show(String page) {
        current = page;
        root = column();
        root.setBackgroundColor(BG);
        root.setLayoutParams(new LinearLayout.LayoutParams(-1, -1));

        if (!page.equals("login")) {
            makeToolbar();
        }

        ScrollView scroll = new ScrollView(this);
        scroll.setFillViewport(true);
        body = column();
        pad(body, 16, 14, 16, 24);
        scroll.addView(body, new ScrollView.LayoutParams(-1, -2));
        root.addView(scroll, new LinearLayout.LayoutParams(-1, 0, 1));
        setContentView(root);

        switch (page) {
            case "login": loginScreen(); break;
            case "home": dashboard(); break;
            case "live": catalog("TV AO VIVO", channels, RED); break;
            case "movies": catalog("FILMES", movies, ORANGE); break;
            case "series": catalog("SÉRIES", series, GREEN); break;
            case "epg": epgScreen(); break;
            case "recordings": recordingsScreen(); break;
            case "settings": settingsScreen(); break;
            case "account": accountScreen(); break;
            case "search": searchScreen(); break;
            case "multi": multiScreen(); break;
            case "radio": radioScreen(); break;
            case "notifications": notificationsScreen(); break;
            case "details": detailsScreen(); break;
            case "player": playerScreen(); break;
            case "favorites": favoritesScreen(); break;
            case "parental": parentalScreen(); break;
            case "users": usersScreen(); break;
            case "general": generalSettingsScreen(); break;
            case "external": externalPlayerScreen(); break;
            default: dashboard(); break;
        }
    }

    private void navigate(String page) {
        if (page.equals(current)) return;
        history.add(current);
        show(page);
    }

    @Override
    public void onBackPressed() {
        if (!history.isEmpty()) {
            String previous = history.remove(history.size() - 1);
            show(previous);
        } else if (!current.equals("home") && !current.equals("login")) {
            show("home");
        } else if (current.equals("home")) {
            show("login");
        } else {
            super.onBackPressed();
        }
    }

    private void makeToolbar() {
        LinearLayout bar = row();
        bar.setBackgroundColor(Color.rgb(23,27,38));
        pad(bar, 12, 7, 12, 7);

        TextView back = button("‹", PANEL2, () -> onBackPressed());
        bar.addView(back, lp(44, 44));

