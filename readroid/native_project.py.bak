    }

    private void usersScreen() {
        addSection(body, "USUÁRIOS");
        addCard(body, "USUÁRIO ATUAL", "Perfil local de demonstração",
            RED, "USER", () -> show("home"), 110);
        addButton(body, "VOLTAR AO LOGIN", PANEL2, () -> {
            history.clear();
            show("login");
        });
    }

    private void externalPlayerScreen() {
        addSection(body, "SELEÇÃO DE REPRODUTOR");
        addButton(body, "REPRODUTOR INTERNO", RED, () ->
            Toast.makeText(this, "Selecionado para demonstração.",
                Toast.LENGTH_SHORT).show());
        addButton(body, "REPRODUTOR EXTERNO", PANEL2, () ->
            Toast.makeText(this, "Nenhum reprodutor externo configurado.",
                Toast.LENGTH_SHORT).show());
    }
}
'''


def generate_native_project(root: Path, package: str, manifest: dict,
                             analysis: Path, apk_info: dict) -> dict:
    package = safe_package(package)
    app = root / "app"
    java_dir = app / "src/main/java" / Path(*package.split("."))
    layout_dir = app / "src/main/res/layout"
    values_dir = app / "src/main/res/values"

    java_dir.mkdir(parents=True, exist_ok=True)
    layout_dir.mkdir(parents=True, exist_ok=True)
    values_dir.mkdir(parents=True, exist_ok=True)

    records = _activity_records(manifest)
    java = JAVA_TEMPLATE.replace("__PACKAGE__", package)
    write(java_dir / "MainActivity.java", java)

    write(layout_dir / "activity_main.xml", """<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#11141E">
</LinearLayout>
""")

    write(values_dir / "strings.xml", """<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Minha TV</string>
</resources>
""")

    write(values_dir / "styles.xml", """<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FC8210</item>
        <item name="android:statusBarColor">#11141E</item>
        <item name="android:navigationBarColor">#11141E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
""")

    write(app / "build.gradle", f"""plugins {{
    id 'com.android.application'
}}
android {{
    namespace '{package}'
    compileSdk 35
    defaultConfig {{
        applicationId '{package}'
        minSdk 23
        targetSdk 28
        versionCode 1
        versionName '1.0'
    }}
    compileOptions {{
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }}
}}
""")

    write(root / "settings.gradle", """pluginManagement {
    repositories { google(); mavenCentral(); gradlePluginPortal() }
}
dependencyResolutionManagement {
    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
    repositories { google(); mavenCentral() }
}
rootProject.name = "ProjetoNativo"
include(":app")
""")

    write(root / "build.gradle", """plugins {
    id 'com.android.application' version '8.7.3' apply false
}
""")

    write(root / "gradle.properties", """org.gradle.jvmargs=-Xmx1536m -Dfile.encoding=UTF-8
android.useAndroidX=true
android.nonTransitiveRClass=true
""")

    write(app / "src/main/AndroidManifest.xml", """<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
""")

    screens = [
        {"name": "Login", "route": "login"},
        {"name": "Painel principal", "route": "home"},
        {"name": "TV ao vivo", "route": "live"},
        {"name": "Filmes", "route": "movies"},
        {"name": "Séries", "route": "series"},
        {"name": "EPG", "route": "epg"},
        {"name": "Gravações", "route": "recordings"},
        {"name": "Busca", "route": "search"},
        {"name": "Múltiplas telas", "route": "multi"},
        {"name": "Configurações", "route": "settings"},
        {"name": "Conta", "route": "account"},
        {"name": "Notificações", "route": "notifications"},
        {"name": "Favoritos", "route": "favorites"},
        {"name": "Controle parental", "route": "parental"},
        {"name": "Usuários", "route": "users"},
        {"name": "Reprodutor", "route": "player"},
    ]
    write(root / "screens.json", json.dumps({
        "native_screens": screens,
        "reference_activities_found": records,
    }, ensure_ascii=False, indent=2))

    write(root / "README.md", """# Projeto Android nativo

Aplicativo independente em Java e XML, gerado pelo ReaDroid.

## Telas implementadas
- Login visual com opções XC API e M3U
- Painel principal com cartões e atalhos
- Catálogos demonstrativos de TV, filmes e séries
- Detalhes e tela de reprodução demonstrativa
- Guia de programação (EPG)
- Gravações, busca e favoritos
- Conta, usuários e notificações
- Configurações gerais, controle parental e seleção de reprodutor
- Navegação interna e botão Voltar

## Limitações
O login não autentica em servidores. Os catálogos são dados locais ilustrativos.
A reprodução real, EPG remoto, gravação e sincronização exigem serviços próprios
e autorizados, que não são recuperados da aplicação de referência.

## Compilação
Com Android SDK e Gradle configurados:
`gradle assembleDebug`
""")

    return {
        "package": package,
        "screens_identified": len(screens),
        "reference_activities_found": len(records),
        "java_files_generated": 1,
        "xml_layouts_generated": 1,
        "project_root": str(root),
    }
