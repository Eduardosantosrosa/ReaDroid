        bar.addView(title, new LinearLayout.LayoutParams(0, dp(46), 1));

        TextView search = button("⌕", PANEL2, () -> navigate("search"));
        bar.addView(search, lp(44, 44));

        TextView home = button("⌂", PANEL2, () -> {
            history.clear();
