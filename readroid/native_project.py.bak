    private void accountScreen() {
        addSection(body, "INFORMAÇÕES DA CONTA");
        addCard(body, "USUÁRIO DE DEMONSTRAÇÃO",
            "Dados locais, sem autenticação remota", RED, "USER", () -> {}, 120);
        setting("Tipo de conexão", "Modo de demonstração");
